# ============================================================
# RE:FUDAN apps/site 环境变量模板
# 用法：复制为 .env.local 并填入真实值
#   cp apps/site/.env.example apps/site/.env.local
# .env.local 不应提交到仓库
# ============================================================

# ---------- 必需：Upstash Redis ----------
# 主业务存储：用户、登录 session、推荐缓存、A2A 会话、handoff 状态
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- 必需：DeepSeek ----------
# 当前 A2A 对话生成依赖 DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 可选：外部采集 ----------
# 建议在需要提升 GitHub API 速率时配置
GITHUB_TOKEN=

# ---------- 可选：小红书真实浏览器采集（推荐开启） ----------
# 默认建议使用真实 Chrome 的 CDP 附着模式抓取小红书，
# 避免 headless Chromium 被风控后页面内显示“无法连接到网络”。
SCHOOLMATE_BROWSER_USE_CDP=true
SCHOOLMATE_CDP_ENDPOINT=http://127.0.0.1:9222
SCHOOLMATE_CHROME_USE_SYSTEM_PROFILE=false
SCHOOLMATE_CHROME_PROFILE_DIRECTORY=Default
