# ============================================================
# RE:FUDAN apps/site 环境变量模板
# 用法：复制为 .env.local 并填入真实值
#   cp apps/site/.env.example apps/site/.env.local
# .env.local 已在 .gitignore，不会被提交
# ============================================================

# ---------- DeepSeek (兜底 LLM) ----------
# 当 mentor.consent_status !== "granted" 时使用，用于演示数据回退
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- SecondMe API (主路径) ----------
# 开发者控制台: https://develop.second-me.cn/integrations/list
# 文档: https://develop-docs.second.me/zh/docs

SECONDME_BASE_URL=https://api.mindverse.com/gate/lab
SECONDME_AUTH_URL=https://go.second-me.cn/oauth/
SECONDME_CLIENT_ID=
SECONDME_CLIENT_SECRET=

# OAuth2 回调地址 — 必须与开发者控制台注册的完全一致
SECONDME_REDIRECT_URI=http://localhost:3000/api/auth/secondme/callback

# scope 在控制台创建应用时已选定，此处变量目前未在 URL 里使用，仅作记录
SECONDME_SCOPES=userinfo,chat.write,memory.read
